# ===========================================
# 大模型配置 - 阿里百炼
# !!! 安全提示 !!!
# 原 API Key 已泄露并提交到 Git 历史，必须立即去阿里云百炼控制台吊销并申请新 Key:
# https://bailian.console.aliyun.com/ -> 模型广场 -> API-KEY 管理
# 新 Key 获取后填入下方 OPENAI_API_KEY
# ===========================================
OPENAI_API_KEY=sk-ws-H.RXXRRER.GNb9.MEUCICaeKwKiZg107hJsoTqR8UFLpj4f3WzgQ3zr5LFQ6sKkAiEA8bRgdLFkJO_DpmOB6ObbLza9cQan1Rt-Y9jwfgE7L6Q
OPENAI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_MODEL_NAME=qwen-plus
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=4096

# ===========================================
# 数据库配置
# 默认使用 SQLite（开箱即用，无需额外服务）
# 如需切换 PostgreSQL，取消注释下一行并配置连接信息
# DATABASE_URL=postgresql://postgres:password@localhost:5432/knowledge_system
# ===========================================
DATABASE_URL=sqlite:///./data/app.db

# ===========================================
# 向量数据库配置
# ===========================================
CHROMA_DB_PATH=./data/chroma_db
CHROMA_COLLECTION_NAME=knowledge_slices

# ===========================================
# Redis 配置（Celery 异步任务需要）
# 未启动 Redis 时，Celery 任务将无法使用，但不影响核心 API
# ===========================================
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ===========================================
# JWT 安全配置
# SECRET_KEY 留空时系统会自动生成并持久化到 data/.secret_key
# 生产环境建议通过环境变量设置固定密钥:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# 注意: 原 SECRET_KEY=knowledge-system-jwt-secret-2024-production-change-me 已泄露，禁止再使用
# ===========================================
# SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ===========================================
# 系统配置
# DEBUG_MODE 生产环境必须为 false
# ===========================================
DEBUG_MODE=false
API_PREFIX=/api/v1

# ===========================================
# CORS 跨域配置
# 开发环境仅允许本地前端，生产环境请改为具体域名
# 如需局域网访问，可添加 http://<你的IP>:5173
# ===========================================
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_CREDENTIALS=false

# ===========================================
# 文件上传安全配置
# ===========================================
MAX_UPLOAD_SIZE=52428800
ALLOWED_UPLOAD_EXTENSIONS=.txt,.md,.pdf,.docx,.doc,.json,.csv,.html,.htm,.xml,.rst,.log

# ===========================================
# 速率限制配置
# ===========================================
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_API=100/minute
RATE_LIMIT_UPLOAD=20/minute
