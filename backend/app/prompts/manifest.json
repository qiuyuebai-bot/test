{
  "_comment": "Prompt 模板清单：每个模板对应 templates/<name>.txt 文件，记录版本与变量说明",
  "hallucination_check": {
    "version": "1.0.0",
    "description": "幻觉深度检测：基于参考知识核查生成内容是否含无依据声称",
    "variables": ["reference_knowledge", "content", "suspicious_points"]
  },
  "content_correction": {
    "version": "1.0.0",
    "description": "内容审校修正：根据审核意见修正学习资源中的幻觉/绝对化表述",
    "variables": ["content", "correction_text", "reference_text"]
  },
  "learner_diagnosis": {
    "version": "1.0.0",
    "description": "学习者能力诊断：基于能力评分与盲区生成个性化诊断报告",
    "variables": ["ability_summary", "blind_areas", "average_score"]
  },
  "resource_generation": {
    "version": "1.1.0",
    "description": "个性化学习资源生成：按学习者画像与知识点生成专属资源",
    "variables": ["learner_summary", "knowledge_topic", "resource_type", "difficulty_level", "training_context", "reference_knowledge", "source_coverage_requirements", "coverage_retry_instruction"]
  },
  "question_generation": {
    "version": "1.1.0",
    "description": "分阶测试题生成：按难度等级生成对应题目与解析",
      "variables": ["knowledge_topic", "difficulty_level", "difficulty_standard", "question_count", "multiple_choice_count", "training_context", "reference_knowledge", "excluded_questions", "source_coverage_requirements", "coverage_retry_instruction"]
  },
  "tutoring_feedback": {
    "version": "1.0.0",
    "description": "自适应导学反馈：根据答题结果生成解释、挑战和学习建议",
    "variables": ["decision", "knowledge_topic", "question", "user_answer", "correct_answer", "difficulty", "learning_style", "learner_summary", "reference_knowledge"]
  },
  "lecture_supplement": {
    "version": "1.0.0",
    "description": "讲义增量增补：为答错的新知识盲区生成追加到现有讲义的补充章节",
    "variables": ["learner_summary", "blind_topic", "question_summary", "difficulty_level", "reference_knowledge"]
  },
  "debate_review": {
    "version": "1.0.0",
    "description": "基于参考资料的生成内容辩论与最终裁决",
    "variables": ["round_num", "generated_content", "reference_knowledge", "rule_issues"]
  },
  "generation_review": {
    "version": "1.0.0",
    "description": "生成Agent独立回应审核意见并维护自身立场",
    "variables": ["round_num", "generated_content", "reference_knowledge", "audit_result"]
  },
  "judge_review": {
    "version": "1.0.0",
    "description": "裁判Agent在生成Agent独立回应后进行最终裁决",
    "variables": ["round_num", "generated_content", "reference_knowledge", "rule_issues", "generation_response"]
  },
  "path_planning": {
    "version": "1.0.0",
    "description": "根据能力、盲区与可用资源规划学习路径",
    "variables": ["learner_context"]
  }
}
